#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

&lt { tapping-term-ms = <150>; };

/ {
    combos {
        compatible = "zmk,combos";

        space_hold {
            bindings = <&kp SPACE>;
            key-positions = <24 37>;
            layers = <0>;
        };

        l_cmd {
            bindings = <&kp LGUI>;
            key-positions = <16 15>;
            require-prior-idle-ms = <50>;
        };

        l_opt {
            bindings = <&kp LALT>;
            key-positions = <15 14>;
            require-prior-idle-ms = <50>;
        };

        l_cmd_opt {
            bindings = <&kp LA(LGUI)>;
            key-positions = <14 15 16>;
            require-prior-idle-ms = <50>;
        };

        r_cmd {
            bindings = <&kp RGUI>;
            key-positions = <19 20>;
            require-prior-idle-ms = <50>;
        };

        r_opt {
            bindings = <&kp RALT>;
            key-positions = <20 21>;
            require-prior-idle-ms = <50>;
        };

        r_cmd_opt {
            bindings = <&kp RA(RGUI)>;
            key-positions = <19 20 21>;
            require-prior-idle-ms = <50>;
        };

        l_boot {
            bindings = <&u_bootloader>;
            key-positions = <36 37>;
            layers = <1>;
        };

        r_boot {
            bindings = <&u_bootloader>;
            key-positions = <41 40>;
            layers = <2>;
        };
    };

    behaviors {
        u_bootloader: u_bootloader {
            compatible = "zmk,behavior-tap-dance";
            label = "U_BOOTLOADER";
            #binding-cells = <0>;
            bindings = <&none>, <&bootloader>;
        };

        shift_word: shift_word {
            compatible = "zmk,behavior-tap-dance";
            label = "SHIFT_WORD";
            #binding-cells = <0>;
            bindings = <&kp LSHFT>, <&caps_word>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "base";
            bindings = <
&kp TAB        &kp Q  &kp W  &kp E     &kp R        &kp T  &kp Y      &kp U      &kp I      &kp O    &kp P     &kp BSPC
&mt LCTRL ESC  &kp A  &kp S  &kp D     &kp F        &kp G  &kp H      &kp J      &kp K      &kp L    &kp SEMI  &kp SQT
&kp LSHFT      &kp Z  &kp X  &kp C     &kp V        &kp B  &kp N      &kp M      &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT
                             &kp LGUI  &shift_word  &mo 1  &lt 2 RET  &kp SPACE  &kp RALT
            >;
        };

        sym_layer {
            display-name = "sym";
            bindings = <
&trans  &kp GRAVE  &kp AT    &kp MINUS  &kp DLLR   &kp PRCNT  &kp CARET  &kp HASH  &kp UNDER  &none      &none     &trans
&trans  &kp LBRC   &kp RBRC  &kp LBKT   &kp RBKT   &kp STAR   &kp AMPS   &kp LPAR  &kp RPAR   &kp COLON  &kp SEMI  &trans
&trans  &kp TILDE  &kp EXCL  &kp PLUS   &kp EQUAL  &kp FSLH   &kp PIPE   &kp BSLH  &kp LT     &kp GT     &none     &trans
                             &trans     &trans     &trans     &trans     &trans    &trans
            >;
        };

        num_layer {
            display-name = "num";
            bindings = <
&kp ESC    &kp N1  &kp N2  &kp N3     &kp N4     &kp N5  &kp N6    &kp N7    &kp N8  &kp N9     &kp N0   &kp DEL
&kp LCTRL  &none   &none   &kp PG_UP  &kp PG_DN  &none   &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &none    &none
&trans     &kp F1  &kp F2  &kp F3     &kp F4     &kp F5  &kp F6    &kp F7    &kp F8  &kp F9     &kp F10  &trans
                           &trans     &trans     &trans  &trans    &trans    &trans
            >;
        };
    };
};
